# OrbitIQ Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (optional – app works without DB in demo mode)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=orbitiq_db

# IBM watsonx.ai Configuration (optional – app works with built-in knowledge without it)
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# CORS
FRONTEND_URL=http://localhost:5000

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Knowledge Base
ENABLE_RAG=true
